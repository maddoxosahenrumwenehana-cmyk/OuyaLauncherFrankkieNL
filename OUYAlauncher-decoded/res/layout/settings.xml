<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/layout_background"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="28.0dp">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="90.0dp"
        android:layout_marginBottom="20.0dp">

        <ImageView
            android:id="@id/logo"
            android:layout_width="wrap_content"
            android:layout_height="75.0dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10.0dp"
            android:src="@drawable/logo_default_old"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical">

            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/top_action_button"
                android:layout_width="wrap_content"
                android:layout_height="48.0dp"
                android:layout_marginRight="12.0dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="35.0dp"
                    android:layout_height="35.0dp"
                    android:src="@drawable/btn_ouya_a"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <TextView
                    android:text="OK"
                    android:textSize="18.0sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingLeft="5.0dp"
                    android:paddingRight="10.0dp" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/start_goto_settings"
                android:background="@drawable/top_action_button"
                android:layout_width="wrap_content"
                android:layout_height="48.0dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="35.0dp"
                    android:layout_height="35.0dp"
                    android:src="@drawable/btn_ouya_b"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <TextView
                    android:text="Back"
                    android:textSize="18.0sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingLeft="5.0dp"
                    android:paddingRight="10.0dp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>


    <!-- MAIN CONTENT -->
    <LinearLayout
        android:id="@id/settings_container"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0"
        android:layout_marginLeft="10.0dp"
        android:layout_marginRight="10.0dp">


        <!-- LEFT SETTINGS COLUMN -->
        <ScrollView
            android:layout_width="0.0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:scrollbars="none"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingRight="18.0dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20.0dp" />

                <Button
                    android:id="@id/settings_live_wallpaper"
                    android:text="Change Wallpaper"
                    android:textSize="21.0sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="7.0dp"
                    android:paddingLeft="22.0dp"
                    android:paddingRight="15.0dp"
                    android:background="@drawable/menu_button" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="7.0dp">

                    <Button
                        android:id="@id/settings_logo_baxy"
                        android:text="BAXY Logo"
                        android:textSize="20.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:layout_marginRight="4.0dp"
                        android:background="@drawable/menu_button" />

                    <Button
                        android:id="@id/settings_logo_ouya"
                        android:text="OUYA Logo"
                        android:textSize="20.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:layout_marginLeft="4.0dp"
                        android:background="@drawable/menu_button" />

                    <Button
                        android:id="@id/settings_logo_mados"
                        android:text="MadOS Logo"
                        android:textSize="18.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:layout_marginLeft="4.0dp"
                        android:background="@drawable/menu_button" />

                </LinearLayout>

                <Button
                    android:id="@id/settings_date_format"
                    android:text="Cycle date format"
                    android:textSize="20.0sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="7.0dp"
                    android:paddingLeft="22.0dp"
                    android:paddingRight="15.0dp"
                    android:background="@drawable/menu_button" />


                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="7.0dp">

                    <Button
                        android:id="@id/settings_analog_clock"
                        android:text="Analog Clock"
                        android:textSize="20.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:layout_marginRight="4.0dp"
                        android:background="@drawable/menu_button" />

                    <Button
                        android:id="@id/settings_digital_clock"
                        android:text="Digital Clock"
                        android:textSize="20.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_width="0.0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:layout_marginLeft="4.0dp"
                        android:background="@drawable/menu_button" />

                </LinearLayout>


                <Button
                    android:id="@id/settings_music"
                    android:text="Background Music"
                    android:textSize="21.0sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="7.0dp"
                    android:paddingLeft="22.0dp"
                    android:paddingRight="15.0dp"
                    android:background="@drawable/menu_button" />


                <!-- BETA TOGGLE -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="7.0dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Enable Beta versions"
                        android:textSize="20.0sp"
                        android:textColor="#ffffffff"
                        android:gravity="center_vertical"
                        android:layout_width="0.0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:paddingLeft="10.0dp"
                        style="@style/ShadowText" />

                    <ToggleButton
                        android:id="@id/settings_version_beta_togglebutton"
                        android:layout_width="0.0dp"
                        android:layout_height="48.0dp"
                        android:layout_weight="1.0" />

                </LinearLayout>


                <Button
                    android:id="@id/settings_feedback_btn"
                    android:text="Feedback"
                    android:textSize="21.0sp"
                    android:textColor="#ffffffff"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="58.0dp"
                    android:layout_marginBottom="15.0dp"
                    android:paddingLeft="22.0dp"
                    android:paddingRight="15.0dp"
                    android:background="@drawable/menu_button" />

				<!-- BETA TOOLS -->

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8.0dp"
					android:layout_marginBottom="7.0dp"
					android:text="BETA TOOLS"
					android:textSize="20.0sp"
					android:textColor="#ffffffff"
					android:paddingLeft="10.0dp"
					style="@style/ShadowText" />

				<Button
					android:id="@id/settings_add_widget"
					android:text="Add Widget"
					android:textSize="21.0sp"
					android:textColor="#ffffffff"
					android:gravity="center_vertical"
					android:layout_width="match_parent"
					android:layout_height="58.0dp"
					android:layout_marginBottom="7.0dp"
					android:paddingLeft="22.0dp"
					android:paddingRight="15.0dp"
					android:background="@drawable/menu_button" />

				<Button
					android:id="@id/settings_remove_widgets"
					android:text="Remove all Widgets"
					android:textSize="21.0sp"
					android:textColor="#ffffffff"
					android:gravity="center_vertical"
					android:layout_width="match_parent"
					android:layout_height="58.0dp"
					android:layout_marginBottom="7.0dp"
					android:paddingLeft="22.0dp"
					android:paddingRight="15.0dp"
					android:background="@drawable/menu_button" />

				<Button
					android:id="@id/settings_webserver"
					android:text="Webserver / QR Code"
					android:textSize="21.0sp"
					android:textColor="#ffffffff"
					android:gravity="center_vertical"
					android:layout_width="match_parent"
					android:layout_height="58.0dp"
					android:layout_marginBottom="15.0dp"
					android:paddingLeft="22.0dp"
					android:paddingRight="15.0dp"
					android:background="@drawable/menu_button" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20.0dp" />

                <TextView
                    android:id="@id/settings_version_tv"
                    android:text=""
                    android:textSize="18.0sp"
                    android:textColor="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10.0dp"
                    style="@style/ShadowText" />

            </LinearLayout>

        </ScrollView>


        <!-- RIGHT CLOCK COLUMN -->
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0.0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:paddingLeft="18.0dp">

            <AnalogClock
                android:id="@id/analog_clock"
                android:layout_width="170.0dp"
                android:layout_height="170.0dp" />

            <DigitalClock
                android:id="@id/digital_clock"
                android:textSize="42.0sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/ShadowText" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
